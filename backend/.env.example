# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://akdfa:password@localhost:5432/akdfa_db?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# PII field-encryption key. 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not change once real data exists — it makes existing ciphertext unreadable.
ENCRYPTION_KEY=""

# Server
PORT=4000
# One origin, a comma-separated list, or "*"
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"
PUBLIC_BASE_URL="http://localhost:4000"

# First State Committee account, created by `npm run prisma:seed`
BOOTSTRAP_ADMIN_EMAIL="admin@akdfa.org"
BOOTSTRAP_ADMIN_PHONE="+919000000000"
BOOTSTRAP_ADMIN_PASSWORD="akdfa-admin-2026"

# Payments (Phase 5 — Razorpay). Blank = payments disabled (checkout returns 503).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
MEMBERSHIP_FEE_INR=500

# File uploads. "local" writes to ./uploads and serves them from /uploads.
UPLOAD_DRIVER="local"
UPLOAD_DIR="uploads"
