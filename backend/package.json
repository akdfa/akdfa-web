{
  "name": "akdfa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AKDFA backend API — auth, membership, districts/units, cricket hub, payments, and the AKDFA store",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "setup": "node scripts/with-env.js prisma migrate deploy && node scripts/with-env.js prisma generate && node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/with-env.js prisma migrate dev",
    "prisma:deploy": "node scripts/with-env.js prisma migrate deploy",
    "prisma:studio": "node scripts/with-env.js prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "smoke": "node scripts/smoke.js",
    "e2e": "node scripts/e2e.js",
    "reminders": "node scripts/send-reminders.js",
    "test": "node --test test/*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "nodemailer": "^6.10.1"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0"
  }
}
