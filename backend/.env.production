# Production template. Copy the real secret values into the host's own
# environment, or into backend/.env.production.local (git-ignored) on the box.
# The server REFUSES to start in production if any of the *required* values below
# are missing.  Run with:  NODE_ENV=production npm start
NODE_ENV=production

# ── Required ────────────────────────────────────────────────────────────
DATABASE_URL=""                       # postgresql://user:pass@host:5432/akdfa?schema=public&sslmode=require
JWT_ACCESS_SECRET=""                  # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_REFRESH_SECRET=""                 # a DIFFERENT long random string
ENCRYPTION_KEY=""                     # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  — 64 hex chars, NEVER change once live

# ── URLs ───────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_BASE_URL="https://api.akdfa.org"     # where THIS API is reachable (used for upload + receipt links)
SITE_BASE_URL="https://akdfa.org"           # where the website is served (used for password-reset + verify links)
CORS_ORIGIN="https://akdfa.org,https://www.akdfa.org"

# ── Auth token lifetimes ───────────────────────────────────────────────
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── First State Committee account (created by the seed) ────────────────
BOOTSTRAP_ADMIN_EMAIL="committee@akdfa.org"
BOOTSTRAP_ADMIN_PHONE="+91XXXXXXXXXX"
BOOTSTRAP_ADMIN_PASSWORD=""            # set a strong one, then change it after first login

# ── Payments (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""             # from the Razorpay dashboard webhook config
MEMBERSHIP_FEE_INR=500                 # the Committee-approved annual fee

# ── File storage ──────────────────────────────────────────────────────
UPLOAD_DRIVER="local"                  # "local" (disk) or "s3"
UPLOAD_DIR="uploads"
# When UPLOAD_DRIVER=s3 (works with AWS S3, Cloudflare R2, MinIO, …):
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                        # only for non-AWS S3-compatible stores
S3_PUBLIC_BASE_URL=""                 # CDN/bucket base URL for public files (optional)

# ── Email (notifications, password resets, reminders) ─────────────────
MAIL_DRIVER="log"                     # "log" (prints) or "smtp"
MAIL_FROM="AKDFA <no-reply@akdfa.org>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"                   # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
